# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO
# @BotFather'dan olingan token va o'zingizning Telegram ID'ingiz (@userinfobot)
JARVIS_TELEGRAM_TOKEN=
JARVIS_OWNER_TELEGRAM_ID=0
# Telegram'da sizning nomingizdan yozish sukut bo'yicha EKRAN ORQALI (API kerak emas,
# faqat Accessibility ruxsati). Ixtiyoriy: my.telegram.org kalitlari bo'lsa — ekransiz ishlaydi.
JARVIS_TG_API_ID=
JARVIS_TG_API_HASH=
# Ob-havo uchun shahar
JARVIS_CITY=Tashkent
# Agent (Claude). Bo'sh bo'lsa agent o'chiq — faqat oddiy qoidalar ishlaydi.
# Kalit: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5-5
JARVIS_MODEL_EFFORT=medium
# Ovoz (lokal Whisper). Til: uz, ru, en yoki bo'sh — avtomatik aniqlash
# O'zbek tiliga o'rgatilgan model (asl model: large-v3-turbo)
JARVIS_STT_MODEL=hostmepanda/whisper-large-v3-turbo-uzbek-ct2
JARVIS_STT_LANGUAGE=uz
POSTGRES_PASSWORD=jarvis
# Host portlari (band bo'lsa o'zgartiring)
JARVIS_PORT=8010
JARVIS_DB_PORT=5433
