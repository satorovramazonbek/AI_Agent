# Nusxa oling: cp .env.example .env  (.env git'ga tushmaydi)
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO
# @BotFather'dan olingan token va o'zingizning Telegram ID'ingiz (@userinfobot)
JARVIS_TELEGRAM_TOKEN=
JARVIS_OWNER_TELEGRAM_ID=0
# Ovoz (lokal Whisper). Til: uz, ru, en yoki bo'sh — avtomatik aniqlash
JARVIS_STT_MODEL=large-v3-turbo
JARVIS_STT_LANGUAGE=uz
POSTGRES_PASSWORD=jarvis
# Host portlari (band bo'lsa o'zgartiring)
JARVIS_PORT=8010
JARVIS_DB_PORT=5433
